//@ 3 

trait MyTrait
{
    type TItem;
    TItem GetItem();
}

struct S : MyTrait
{
    int value;
}

impl S : MyTrait
{
    type TItem = int; // type alias

    int GetItem() // alias로 안써도 괜찮아야 한다
    {
        return value;
    }
}

// 리턴값으로 T.TItem이 검색될 수 있어야 함
T.TItem Func<T>(T item) where T : MyTrait
{
    return item.GetItem();
}

void Main()
{
    var x = Func(S(3)); // T가 S로 추론
    @$x
}